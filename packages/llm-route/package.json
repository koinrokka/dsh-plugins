{
  "name": "@koinrokka/dsh-llm-route",
  "version": "0.1.0",
  "description": "koinrokka LLM routing glue: mounts dsh-llm-pi-ai with the pi-ai catalog routes we ship (zai-coding-cn via ZAI_CODING_CN_API_KEY; deepseek-official stays on the SDK fallback).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test --test-timeout=15000 \"test/*.test.ts\""
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.3",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.3",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.3",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.3",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.3",
    "@deepseek-ai/dsh-launch-environment": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.3",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.3",
    "@types/node": "^24.0.0",
    "tsdown": "^0.14.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}